# Copia este archivo como .env y ajusta los valores
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=cafeteria_db

# Frontend Angular (separa varios orígenes con coma)
CORS_ORIGIN=http://localhost:4200

# Ollama (chatbot). Instala Ollama y ejecuta: ollama pull gemma3
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3
OLLAMA_TIMEOUT_MS=180000
